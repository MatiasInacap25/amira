    {
      "dot": "cyan",
      "title": "Frontend session",
      "items": [
        "src/proxy.ts runs updateSession on each matched request (frontend/src/proxy.ts:4-6)",
        "Supabase client refreshes the session via getClaims (frontend/src/lib/supabase/proxy.ts:27)",
        "The browser never queries the database directly"
